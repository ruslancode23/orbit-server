# Copy to .env and adjust. Values below match deploy/docker-compose.yml for local development.
# PostgreSQL from compose listens on 5433 so it does not clash with a local PostgreSQL on 5432.
ORBIT_POSTGRES_PORT=5433
ORBIT_ENV=development
ORBIT_HTTP_ADDR=:8080
ORBIT_SHUTDOWN_TIMEOUT=15s
ORBIT_DATABASE_URL=postgres://orbit:orbit@localhost:5433/orbit?sslmode=disable
ORBIT_CORS_ORIGINS=http://localhost:5173
# How long a session cookie stays valid (Go duration). Default 720h = 30 days.
ORBIT_SESSION_TTL=720h
# Largest group chat, counting its creator. Default 10.
ORBIT_MAX_GROUP_MEMBERS=10
# New conversations one account may open per minute, shared with the first message
# of a dialogue. Default 10; 0 turns the limit off.
ORBIT_NEW_CONVERSATION_LIMIT=10
# Friendships per account. Default 1000; accepting over the limit answers 409.
ORBIT_MAX_FRIENDS=1000
# Friendship requests one account may send per day and may keep pending.
# Defaults 20 and 100; 0 turns either guard off. Both answer 429 with Retry-After.
ORBIT_FRIEND_REQUEST_DAILY_LIMIT=20
ORBIT_FRIEND_REQUEST_PENDING_LIMIT=100
# How many times one account may change its nickname per hour. Default 2;
# 0 turns the guard off. A refusal answers 429 with Retry-After.
ORBIT_NICKNAME_CHANGE_HOURLY_LIMIT=2
# Bug reports one account may send per hour. Default 5; 0 turns the guard off.
# A refusal answers 429 with Retry-After.
ORBIT_BUG_REPORTS_PER_HOUR=5

# Sign-in and sign-up guards (429 with Retry-After). Production defaults: 20 sign-in
# attempts per minute per address, 10 wrong passwords per hour per login name (a
# successful sign-in costs nothing), 30 new accounts — registered or guest — per hour
# per address. 0 turns a guard off. Locally every browser and the e2e suite share
# 127.0.0.1, so the per-address guards are off here; the per-name one stays on.
ORBIT_LOGIN_PER_MINUTE_PER_IP=0
ORBIT_LOGIN_FAILURES_PER_HOUR=10
ORBIT_SIGNUPS_PER_HOUR_PER_IP=0
# Reverse proxies whose X-Forwarded-For names the client, as addresses or CIDR
# (e.g. 127.0.0.1,10.0.0.0/8). Empty: the connection's peer is the client and the
# header is ignored — anyone can send it.
ORBIT_TRUSTED_PROXIES=

# LiveKit dev mode uses the fixed pair devkey / secret. Never use it in production.
LIVEKIT_URL=ws://localhost:7880
# URL returned to clients; defaults to LIVEKIT_URL. Set it when the server reaches LiveKit by an internal address.
# LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# S3-compatible file storage (SeaweedFS in deploy/docker-compose.yml)
ORBIT_S3_ENDPOINT=http://localhost:8333
ORBIT_S3_BUCKET=orbit
ORBIT_S3_ACCESS_KEY=orbit
ORBIT_S3_SECRET_KEY=orbit-dev-secret
# Largest attachment, in bytes. Default 26214400 (25 MiB).
ORBIT_MAX_UPLOAD_BYTES=26214400
# How long a download link stays valid (Go duration). Default 10m.
ORBIT_ATTACHMENT_LINK_TTL=10m
# How long a file whose message never arrived is kept before the sweep. Default 24h.
ORBIT_ORPHAN_ATTACHMENT_AGE=24h
# Largest server icon (PNG, JPEG or WebP), in bytes. Default 2097152 (2 MiB).
ORBIT_MAX_ICON_BYTES=2097152
# How long the signed link to a server icon stays valid (Go duration). Default 1h.
ORBIT_ICON_LINK_TTL=1h
# Largest avatar (PNG, JPEG or WebP, re-encoded to WebP), in bytes.
# Default 8388608 (8 MiB).
ORBIT_MAX_AVATAR_BYTES=8388608
# How long the signed avatar link stays valid (Go duration). Default 168h (7 days),
# which is also the longest a presigned S3 link can live.
ORBIT_AVATAR_LINK_TTL=168h
# Largest screenshot attached to a bug report (PNG, JPEG or WebP), in bytes.
# Default 5242880 (5 MiB).
ORBIT_MAX_SCREENSHOT_BYTES=5242880

# Web Push (notifications with no Orbit tab open). All three or none; none turns
# push off. Generate the pair once per instance: make vapid-keys. Changing the
# public key silently breaks every existing browser subscription.
ORBIT_VAPID_PUBLIC_KEY=
ORBIT_VAPID_PRIVATE_KEY=
# Who push services may contact about this sender: mailto: or https: URL.
ORBIT_VAPID_SUBJECT=

# Local end-to-end tests only: let the link-preview fetcher reach loopback and
# private addresses so a test HTTP server can serve an OpenGraph page. Never
# turn this on in production — it is the SSRF guard's off switch.
ORBIT_LINK_PREVIEW_ALLOW_PRIVATE=0
